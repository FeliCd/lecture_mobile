# Non-secret backend settings; copy to functions/.env.local for emulator use.
# OPENALEX_API_KEY goes in functions/.secret.local (emulator) or Secret Manager.
CROSSREF_MAILTO=
# Production: firebase functions:secrets:set QR_SIGNING_SECRET / OPENALEX_API_KEY
# Generate a cryptographically random signing secret; never ship it in Flutter.
ENFORCE_APP_CHECK=false
